const s:scriptdir = expand('<sfile>:p:h')

function s:error(msg) abort
  %delete _
  call setline(1, a:msg)
  %print
endfunction

function s:to_camel_case(text) abort
  return substitute(a:text, '\%(^\|_\)\(\w\)', '\=toupper(submatch(1))', 'g')
endfunction

function s:partition(list, pred) abort
  let retval = [[], []]
  for v in a:list
    call extend(retval[call(a:pred, [v]) ? 0 : 1], [v])
  endfor
  return retval
endfunction

function s:find_duplicate_entries(list) abort
  let dup = {}
  let seen = {}
  for v in a:list
    if has_key(seen, v)
      let dup[v] = v:true
    else
      let seen[v] = v:true
    endif
  endfor
  return dup
endfunction

function s:merge_duplicate_abbrev(abbrevs) abort
  let dups = s:find_duplicate_entries(a:abbrevs->copy()->map({ _, v -> v[0] }))
  let [should_merge, defabbrevs] = s:partition(a:abbrevs, { v -> has_key(dups, v[0]) })
  let merge_table = {}
  for v in should_merge
    if !has_key(merge_table, v[0])
      let merge_table[v[0]] = []
    endif
    call add(merge_table[v[0]], v[1])
  endfor
  for [k, v] in items(merge_table)
    call add(defabbrevs, [k, $'<SID>try_one_by_one({string(k)}, {string(v)})'])
  endfor
  return defabbrevs
endfunction

function s:main() abort
  if trim($THEMIS_VIM_DIR) ==# ''
    throw '$THEMIS_VIM_DIR is empty.'
  endif

  if !executable('git')
    throw 'The "git" command is not executable.'
  endif

  if !isdirectory($'{$THEMIS_VIM_DIR}/doc')
    throw '$THEMIS_VIM_DIR/doc is not a directory.'
  endif

  const getrevcmd = ['git', '-C', $THEMIS_VIM_DIR, 'log', '-1', '--format=%h']
  const rev = system(getrevcmd)->trim()
  if v:shell_error
    throw $"Error while command execution: {getrevcmd}\n{rev}"
  endif
  let ftplugin =<< trim eval END
    " NOTE THAT THIS FILE IS AUTOMATICALLY GENERATED.
    " The source themis.vim revision: {rev}
  END
  let ftplugin += ['']
  let ftplugin += readfile(s:scriptdir . '/vimspec.base.vim')

  set runtimepath=$THEMIS_VIM_DIR
  helptags ALL

  let defabbrevs = []
  let undefabbrevs = []

  let commands =<< trim EOF
  Describe
  Context
  Before
  After
  It
  End
  EOF
  let commands += getcompletion('themis-helper-command-:', 'help')
    \->map({ _, v -> matchstr(v, '^themis-helper-command-:\zs.*$')})

  for command in commands
    let trigger = tolower(command)
    call add(defabbrevs, [trigger, $'<SID>command_abbrev({string(trigger)}, {string(command)})'])
    call add(undefabbrevs, trigger)
  endfor

  let subcommands = getcompletion('themis-helper-assert-', 'help')
    \->filter({ _, v -> v =~# '()$' })
    \->map({ _, v -> matchstr(v, '^themis-helper-assert-\zs.*\ze()$') })
    \->sort()
  for subcmd in subcommands
    let trigger = tolower(substitute(subcmd, '_', '', 'g'))
    let abbrev = s:to_camel_case(subcmd)
    call add(defabbrevs, [trigger, $'<SID>subcommand_abbrev("Assert", {string(trigger)}, {string(abbrev)})'])
    call add(undefabbrevs, trigger)
  endfor

  let subcommands = getcompletion('themis-helper-expect-', 'help')
    \->filter({ _, v -> v =~# '()$' })
    \->map({ _, v -> matchstr(v, '^themis-helper-expect-\zs.*\ze()$') })
    \->sort()
  for subcmd in subcommands
    let trigger = tolower(substitute(subcmd, '_', '', 'g'))
    let abbrev = s:to_camel_case(subcmd)
    call add(defabbrevs, [trigger, $'<SID>subcommand_abbrev("Expect", {string(trigger)}, {string(abbrev)})'])
    call add(undefabbrevs, trigger)
  endfor

  let defabbrevcmds = defabbrevs
    \->s:merge_duplicate_abbrev()
    \->map({ _, v -> $'call s:set_abbrev({string(v[0])}, {string(v[1])})' })
  call add(ftplugin, '')
  call extend(ftplugin, defabbrevcmds)

  let undo_ftplugin =<< trim END
    if exists('b:undo_ftplugin')
      let b:undo_ftplugin = ' | ' . b:undo_ftplugin
    else
      let b:undo_ftplugin = ''
    endif
    let b:undo_ftplugin = $'call {expand('<SID>')}clear_abbrevs({string(s:defined_abbrev_triggers->sort()->uniq())})' . b:undo_ftplugin
  END
  call add(ftplugin, '')
  call extend(ftplugin, undo_ftplugin)

  call writefile(ftplugin, fnamemodify(s:scriptdir, ':h') .. '/ftplugin/vimspec.vim')
endfunction

try
  call s:main()
  quitall!
catch
  call s:error([v:throwpoint, v:exception]->map({ _, v -> v->split("\n") })->flatten())
  cquit
endtry

